# Copy to .dev.vars for `wrangler dev`. .dev.vars is gitignored; never commit it.
# For local dev also override PUBLIC_BASE_URL=http://localhost:8788 here.

# Cloudflare Access for SaaS (OIDC) application: see README "Cloudflare Access".
ACCESS_CLIENT_ID=
ACCESS_CLIENT_SECRET=
ACCESS_TOKEN_URL=
ACCESS_AUTHORIZATION_URL=
ACCESS_JWKS_URL=
# Random 32+ byte hex string: openssl rand -hex 32
COOKIE_ENCRYPTION_KEY=

# Optional: enables the meteoblue provider.
METEOBLUE_API_KEY=
