# Names only. Set real values as Cloudflare secrets (`npx wrangler secret put NAME`)
# or, for `wrangler dev`, in a local .dev.vars file (gitignored).

# Cloudflare Access for SaaS (OIDC) application: see README "Cloudflare Access".
ACCESS_CLIENT_ID=
ACCESS_CLIENT_SECRET=
ACCESS_TOKEN_URL=
ACCESS_AUTHORIZATION_URL=
ACCESS_JWKS_URL=
# Random 32+ byte hex string: openssl rand -hex 32
COOKIE_ENCRYPTION_KEY=

# Optional: enables the meteoblue provider.
METEOBLUE_API_KEY=
